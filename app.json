{
  "expo": {
    "name": "Palais Mental",
    "slug": "palais-mental",
    "version": "0.0.4",
    "scheme": "palaismental",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBEEDD",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.palaismental.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.palaismental.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-asset",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
