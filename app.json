{
  "expo": {
    "name": "Palais Mental",
    "slug": "palais-mental",
    "version": "0.1.1",
    "scheme": "palaismental",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBEEDD",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.palaismental.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.palaismental.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-asset",
      "expo-status-bar",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
