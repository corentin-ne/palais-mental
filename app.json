{
  "expo": {
    "name": "Palais Mental",
    "slug": "palais-mental",
    "version": "1.4.1",
    "scheme": "palaismental",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EAF3FB",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.palaismental.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Palais Mental reads what you watched from your Plex, Jellyfin or Emby server on your network."
      },
      "buildNumber": "141"
    },
    "android": {
      "package": "com.palaismental.app",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A2540"
      },
      "versionCode": 141
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Palais Mental"
    },
    "plugins": [
      "expo-asset",
      "expo-router",
      "expo-localization",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#EAF3FB",
          "dark": {
            "backgroundColor": "#061423"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B63CE"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
